# KeeperHub Configuration
# Organization-scoped key (kh_ prefix). User-scoped wfb_ keys are REJECTED.
# Create at: app.keeperhub.com -> Settings -> API Keys -> Organisation tab.
# The agent routes ALL defensive transactions through KeeperHub Direct Execution;
# the org's Turnkey-backed wallet signs (the agent never signs defense txs).
KEEPERHUB_API_KEY=kh_your_organization_api_key_here
# Optional override (defaults to https://app.keeperhub.com/api)
# KEEPERHUB_BASE_URL=https://app.keeperhub.com/api

# Network Config (Base Sepolia)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
CHAIN_NAME=Base Sepolia
BLOCKSCAN_URL=https://sepolia.basescan.org

# Demo Treasury Wallet — used ONLY to (a) sign attestations and (b) trigger the
# demo "chaos" action against our own MockVault. Defensive transactions do NOT
# use this key; they go through KeeperHub. REQUIRED — agent refuses to start
# without it. Use a FRESH, dedicated key; never reuse a key from another project.
TREASURY_PRIVATE_KEY=your_private_key_here

# Monitored positions: comma-separated `id:address:label`
# Example: position-1:0x1234...:Aave · WETH/USDC,position-2:0xabcd...:Compound · DAI
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
POSITION_LABEL=Aave · WETH/USDC
# POSITIONS=position-1:0x1234...:Aave · WETH/USDC,position-2:0xabcd...:Compound · DAI

# Agent tuning
HEALTH_THRESHOLD=1.10
POLL_INTERVAL_MS=5000
PORT=4000
DATA_DIR=./data

# Chaos endpoint protection (P1)
CHAOS_RATE_LIMIT=5
# Optional shared secret; if set, POST /api/chaos-mode/trigger requires header x-chaos-secret
# CHAOS_TRIGGER_SECRET=some_long_random_string

# Watcher / mesh identity (stamped into every signed incident report)
WATCHER_ID=guardian-node-1
WATCHER_FRAMEWORK=raw-node

# ---- Sentinel Mesh (§2) — multi-watcher race / consensus ----
# When enabled, each incident races independent watcher agents; only the winner
# (first proposal that passes KeeperHub simulation) executes. Set false to keep
# the single-guardian escalating workflow.
MESH_ENABLED=true
# Stake each watcher posts behind its proposal (test-USDC base units, 6 decimals).
# Watchers whose simulation FAILS are slashed; second-place winners keep their stake.
WATCHER_STAKE=1000000
# Optional per-watcher demo keys (deterministic keys derived from id when unset).
# WATCHER_MCP_KEY=0x_watcher_2_key
# WATCHER_LC_KEY=0x_watcher_3_key

# ---- KeeperHub MCP (§1.2) ----
# Optional override of the MCP endpoint (defaults to https://app.keeperhub.com/mcp).
# KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# ---- MPP standing retainer (§1.5 / §3.4) ----
# A recurring "protection premium" the protocol pays the mesh for continuous
# watching, independent of incident bounties. Only accrues/settles when set.
# MPP_ASSET=0x_test_usdc_erc20_address
# MPP_PAYOUT_ADDRESS=0x_mesh_retainer_payout_address
# MPP_AMOUNT_PER_PERIOD=5000000
# MPP_PERIOD_SECONDS=86400
# MPP_PROTOCOL=MockVault


# x402 outcome-gated settlement (OPTIONAL — only settles when ALL three are set).
# The winning watcher is paid a bounty ONLY after the incident report's
# attestation verifies AND the defensive tx receipt is confirmed on-chain.
# X402_ASSET=0x_test_usdc_erc20_address
# X402_PAYER_KEY=insurance_pool_or_escrow_signer_private_key
# X402_PAYOUT_ADDRESS=0x_winning_watcher_payout_address
# X402_BASE_USDC=5

